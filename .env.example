# Copy to .env for local testing (node scripts/dev.mjs). On Vercel, add these in
# Project → Settings → Environment Variables instead.

# --- Database (admin panel) ---
# Vercel → Storage → Create → Neon Postgres → connect to this project: DATABASE_URL is added for you.
# Use the pooled connection string. Then run: npm run db:migrate (with DATABASE_URL in .env)
DATABASE_URL=

# --- Admin login (/admin) ---
ADMIN_PASSWORD=
# Long random string that signs the login cookie (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=

# --- Meta ---
# Meta Pixel ID (same value as PIXEL_ID in assets/js/config.js)
META_PIXEL_ID=
# Conversions API access token: Events Manager → your pixel → Settings → Conversions API → Generate access token
META_CAPI_TOKEN=
# Optional: test code (e.g. TEST12345). Can also be set in /admin → Settings. Remove before launch.
META_TEST_EVENT_CODE=
# Optional: Graph API version (default v23.0)
META_API_VERSION=
# Optional: fallback page URL for manual sends from admin (default https://knightfit.io/)
SITE_URL=

# --- Cal.com ---
# Cal.com → Settings → Developer → Webhooks → secret you set there
CAL_WEBHOOK_SECRET=

# --- Email alerts (Gmail SMTP) ---
# Gmail address that sends alerts + an App Password (Google Account → Security → 2-Step Verification → App passwords)
SMTP_USER=
SMTP_PASS=
# Who receives alerts (comma-separate for several)
ALERT_EMAIL_TO=

# --- Lead forwarding (optional) ---
# Where completed applications are also POSTed as JSON (GoHighLevel inbound webhook, Zapier, Make, Apps Script...)
LEAD_WEBHOOK_URL=
# Optional shared secret sent as X-Webhook-Secret header
LEAD_WEBHOOK_SECRET=

# --- AI texting (SMSLoop) ---
# Knight's SMSLoop service URL (e.g. https://knight-smsloop.up.railway.app) and its lead-source secret
# (SMSLoop dashboard → Settings → Integrations → Lead source). Leave blank to send nothing.
SMSLOOP_URL=
SMSLOOP_SECRET=
